generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. UTILISATEURS & AUTHENTIFICATION (Standard NextAuth)
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  lorcanaApiKey String?
  dreambornUrl  String?

  accounts      Account[]
  sessions      Session[]
  teams         TeamMember[]
  games         Game[]
  queueStats    UserQueueStat[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 2. SYSTÈME MULTI-ÉQUIPES (SaaS)
// ------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  inviteToken String   @unique @default(uuid())
  createdAt   DateTime @default(now())

  members     TeamMember[]
  games       Game[]
}

// Table de liaison entre Utilisateur et Équipe avec un Rôle
model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

enum Role {
  ADMIN
  MEMBER
}

// ------------------------------------------------------
// 3. DONNÉES DU JEU (Rattachées aux équipes et joueurs)
// ------------------------------------------------------

model Game {
  id             String   @id // On retire @default(cuid()) car l'ID vient de l'API (game.game_id)
  result         String
  wentFirst      Boolean?
  myDeckColors   String?
  oppDeckColors  String?
  oppDisplayName String
  replayUrl      String?
  yourDecklist   String?  @db.Text
  startedAt      DateTime @default(now())
  queueId        String?
  endReason      String?
  myLore         Int?
  oppLore        Int?
  mmrBefore      Float?
  mmrAfter       Float?
  mmrDelta       Float?

  userId         String
  teamId         String

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
}

model QueueConfig {
  id       String  @id
  isActive Boolean @default(true)
}

model Card {
  id        String   @id
  name      String
  imageUrl  String
  type      String?
  cost      Int?
  lastUsed  DateTime @default(now())
}

model UserQueueStat {
  id          String   @id @default(cuid())
  queueId     String   // "core-bo1", "draft", etc.
  mmr         Int      @default(1000)
  gamesPlayed Int      @default(0)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, queueId])
  @@index([userId])
}