generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. UTILISATEURS & AUTHENTIFICATION (Standard NextAuth)
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  lorcanaApiKey String?
  duelsUserId          String?
  duelsUsername        String?
  duelsAccessToken     String?   @db.Text
  duelsTokenExpiresAt  DateTime?
  dreambornUrl  String?

  accounts     Account[]
  sessions     Session[]
  teams        TeamMember[]
  activeTeamId String?
  games        Game[]
  queueStats   UserQueueStat[]

  tournamentsCreated       Tournament[]            @relation("CreatedTournaments")
  tournamentParticipations TournamentParticipant[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 2. SYSTÈME MULTI-ÉQUIPES (SaaS)
// ------------------------------------------------------

model Team {
  id           String       @id @default(cuid())
  name         String
  logoUrl      String?
  inviteToken  String       @unique @default(uuid())
  createdAt    DateTime     @default(now())
  activeQueues String[]     @default([])
  members      TeamMember[]
  tournaments  Tournament[]
}

// Table de liaison entre Utilisateur et Équipe avec un Rôle
model TeamMember {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

enum Role {
  ADMIN
  MEMBER
}

// ------------------------------------------------------
// 3. DONNÉES DU JEU (Rattachées aux équipes et joueurs)
// ------------------------------------------------------

model Game {
  id             String   @id // On retire @default(cuid()) car l'ID vient de l'API (game.game_id)
  result         String
  wentFirst      Boolean?
  myDeckColors   String?
  oppDeckColors  String?
  oppDisplayName String
  replayUrl      String?
  yourDecklist   String?  @db.Text
  startedAt      DateTime @default(now())
  queueId        String?
  endReason      String?
  myLore         Int?
  oppLore        Int?
  mmrBefore      Float?
  mmrAfter       Float?
  mmrDelta       Float?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Card {
  id       String   @id
  name     String
  imageUrl String
  type     String?
  cost     Int?
  lastUsed DateTime @default(now())
}

model UserQueueStat {
  id          String @id @default(cuid())
  queueId     String // "core-bo1", "draft", etc.
  mmr         Int    @default(1000)
  gamesPlayed Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, queueId])
  @@index([userId])
}

// ------------------------------------------------------
// 4. MODULE TOURNOIS
// ------------------------------------------------------

enum TournamentFormat {
  SWISS
  SWISS_TOP_CUT
  SINGLE_ELIMINATION
  ROUND_ROBIN
}

enum TournamentStatus {
  REGISTRATION
  RUNNING
  TOP_CUT
  FINISHED
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

enum MatchFormat {
  BO1
  BO3
}

model Tournament {
  id                 String           @id @default(cuid())
  teamId             String
  name               String
  format             TournamentFormat @default(SWISS)
  status             TournamentStatus @default(REGISTRATION)
  matchFormat        MatchFormat      @default(BO3)
  set                String?
  allowDeckChanges   Boolean          @default(false)
  topCutSize         Int?
  roundsCount        Int?
  currentRoundNumber Int              @default(0)
  createdAt          DateTime         @default(now())
  createdById        String

  team         Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation("CreatedTournaments", fields: [createdById], references: [id], onDelete: Cascade)
  participants TournamentParticipant[]
  rounds       TournamentRound[]

  @@index([teamId])
  @@index([createdById])
}

model TournamentParticipant {
  id                 String   @id @default(cuid())
  tournamentId       String
  userId             String
  officialDecklist   String?  @db.Text
  officialDeckColors String[] @default([])
  dropped            Boolean  @default(false)
  droppedAtRound     Int?
  seed               Int?
  joinedAt           DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchesAsPlayer1 TournamentMatch[] @relation("MatchPlayer1")
  matchesAsPlayer2 TournamentMatch[] @relation("MatchPlayer2")
  matchesWon       TournamentMatch[] @relation("MatchWinner")

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

model TournamentRound {
  id           String      @id @default(cuid())
  tournamentId String
  roundNumber  Int
  isTopCut     Boolean     @default(false)
  status       MatchStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    TournamentMatch[]

  @@index([tournamentId])
}

model TournamentMatch {
  id                String      @id @default(cuid())
  roundId           String
  tableNumber       Int
  player1Id         String
  player2Id         String?
  duelsTableId      String?
  duelsTableUrl     String?
  player1Score      Int         @default(0)
  player2Score      Int         @default(0)
  isBye             Boolean     @default(false)
  isForfeit         Boolean     @default(false)
  winnerId          String?
  status            MatchStatus @default(PENDING)
  replayUrl         String?
  player1Deck       String?     @db.Text
  player2Deck       String?     @db.Text
  player1DeckColors String[]    @default([])
  player2DeckColors String[]    @default([])
  wentFirstWinner   Boolean?

  round   TournamentRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player1 TournamentParticipant  @relation("MatchPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2 TournamentParticipant? @relation("MatchPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  winner  TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([roundId])
  @@index([player1Id])
  @@index([player2Id])
  @@index([winnerId])
}
